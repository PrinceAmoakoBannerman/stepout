# Base URL of the Django REST API. Leave unset to run on local demo data.
VITE_API_URL=http://localhost:8000/api

# Set to "true" once the Django backend is live to route services through the API.
VITE_USE_API=false

# Paystack public key (checkout is UI-only until this is wired up).
VITE_PAYSTACK_PUBLIC_KEY=
